# Обов'язкові змінні для авторизації
# Створіть проєкт в Google Cloud Console для отримання ключів
AUTH_GOOGLE_ID="your_google_client_id_here"
AUTH_GOOGLE_SECRET="your_google_client_secret_here"

# Секретний ключ для шифрування сесій NextAuth (Auth.js)
# Згенеруйте за допомогою: npx auth secret
AUTH_SECRET="your_generated_secret_here"

# Базовий URL додатку (не обов'язково у новій версії, але корисно мати)
AUTH_URL="http://localhost:3000"

# URL для MockAPI (завдання)
MOCKAPI_URL="https://your_mockapi_project_id.mockapi.io/tasks"

# Порт, на якому працюватиме додаток (використовується в Docker)
PORT="3000"